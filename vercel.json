{
  "rewrites": [
    {
      "source": "/proxy-module-a/(.*)",
      "destination": "https://poki.com"
    },
    {
      "source": "/proxy-module-b/(.*)",
      "destination": "https://minecraft.net"
    }
  ]
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "ALLOWALL" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
